    P1 -.-> G
    P6 -.-> G

    classDef step fill:#1E3A8A,stroke:#172554,stroke-width:1.8px,color:#FFFFFF;
    classDef gate fill:#DC2626,stroke:#991B1B,stroke-width:1.8px,color:#FFFFFF;
    classDef warn fill:#FEF2F2,stroke:#DC2626,stroke-width:2px,color:#991B1B;

    class P2,P3,P4,P5,P7,P8 step;
    class P1,P6 gate;
