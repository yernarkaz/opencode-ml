graph TB
    subgraph Flow ["Execution Flow"]
        direction LR
        P1((Plan)) --> P2((EDA)) --> P3((Cleanse)) --> P4((Build)) --> P5((Evaluate)) --> P6((Review)) --> P7((Deploy)) --> P8((Monitor))
